{
  "name": "yeet-street",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/shared",
      "$ignoreUnknownInstances": true
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server",
      "$ignoreUnknownInstances": true
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Dev": {
        "$path": "src/dev",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client",
        "$ignoreUnknownInstances": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "FallenPartsDestroyHeight": -2000
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
